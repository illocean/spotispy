{
  "name": "spotispy",
  "version": "0.2.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --test --test-isolation=process --test-timeout=60000 --test-force-exit \"tests/*.test.js\"",
    "test:ui": "node --test --test-isolation=process --test-timeout=60000 --test-force-exit \"tests/ui/*.test.js\"",
    "test:all": "npm test && npm run test:ui",
    "build": "node tools/build.js"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/illocean/spotispy.git"
  }
}
